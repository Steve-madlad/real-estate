# syntax=docker/dockerfile:1

ARG NODE_VERSION=22
################################################################################
# Use node image for base image for all stages.
FROM node:${NODE_VERSION}-alpine AS base

# Set working directory for all build stages.
WORKDIR /usr/src/app

################################################################################
# Create a stage for installing all dependecies.
FROM base AS build

# Set build arguments for the environment variables that will be used in the build stage.
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_COGNITO_USER_POOL_ID
ARG NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID
ARG NEXT_PUBLIC_MAPBOX_TOKEN
ARG NEXT_PUBLIC_APP_URL

# Set environment variables for the build stage.
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_COGNITO_USER_POOL_ID=$NEXT_PUBLIC_COGNITO_USER_POOL_ID \
    NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=$NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID \
    NEXT_PUBLIC_MAPBOX_TOKEN=$NEXT_PUBLIC_MAPBOX_TOKEN \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL

# Downloading additional development dependencies before building, AS TS needs to be compiled.
# Copy package.json and package-lock.json to the working directory.
COPY package*.json .
RUN --mount=type=cache,target=/root/.npm \
    npm ci --legacy-peer-deps

# Copy the rest of the source files into the image.
COPY . .
# Run the build script with standalone mode.
RUN npm run build

################################################################################
# Create a new stage to run the application 
# docker build -t real-estate-frontend . -f Dockerfile.standalone with minimal runtime dependencies 
# where the necessary files are inherited from the build stage.

# We will not be using the staging stage as we are using the standalone build output from Next.js.
# FROM build AS staging

# RUN --mount=type=cache,target=/root/.npm \
#     npm ci --omit=dev --legacy-peer-deps

################################################################################
# Create a stage for building the application.
FROM base AS final

# Use production node environment by default.
ENV NODE_ENV=production

# Run the application AS a non-root user.
USER node

# Copy the production dependencies from the deps stage and also
# The built application, static folder and public assets from the build stage into the image.
COPY --from=build --chown=node:node /usr/src/app/.next/standalone ./
COPY --from=build --chown=node:node /usr/src/app/.next/static ./.next/static
COPY --from=build --chown=node:node /usr/src/app/public ./public

# Expose the port that the application listens on.
EXPOSE 3000

# Run the application.
CMD ["node", "server.js"]
